node_modules/
dist/
build/

# Variáveis de ambiente (segredos: chaves de API, senha do banco, JWT secret,
# credenciais SMTP) — NUNCA versionar. Só .env.example (sem valores reais) sobe.
.env
.env.*
!.env.example

*.log
npm-debug.log*

.DS_Store
Thumbs.db

coverage/
backend/generated/

# Arquivos enviados pelos usuários (PDFs de catálogos reais) e armazenamento
# local de desenvolvimento — nunca deveriam ir pro repositório.
backend/storage/

# PDFs reais de catálogos de fabricantes, usados manualmente no teste de
# acurácia da IA (RNF10) — material com direitos do fabricante, não deve ir
# pro repositório público. Os gabaritos (dados extraídos manualmente, em JSON)
# continuam versionados normalmente; só o PDF binário fica de fora.
backend/tests/acuracia-ia/pdfs/

# Saída temporária de `npm test > arquivo.txt`, usada só para depuração durante
# o desenvolvimento (terminal não permitia copiar o log inteiro) — não é
# artefato do projeto.
backend/resultado-testes-api.txt
backend/tests/pdfs/

# Playwright (E2E, item 5 do plano de testes avançados) — relatórios/artefatos
# gerados a cada execução local, não são código do projeto.
e2e/test-results/
e2e/playwright-report/
e2e/playwright/.cache/
# Log do `npm run dev:backend` redirecionado a arquivo (mesmo workaround do
# resultado-testes-api.txt) — usado pela jornada 3 (recuperação de senha) para
# ler o link de redefinição impresso pelo ConsoleEmailService.
backend/dev-server.log

# Editores/IDEs
.vscode/
.idea/

# Chaves/certificados, por precaução
*.pem
*.key

# Documentação de apoio de uso pessoal do autor (contexto de desenvolvimento,
# histórico, prompts de agentes, material de TCC, auditorias) — não faz parte
# do que o projeto precisa pra rodar, fica só localmente. Casos exatos como
# estão no disco (confirmados via `git status`) + variantes de capitalização,
# por precaução (alguns sistemas de arquivo/git tratam maiúsculas como
# distintas). O README.md da raiz e o backend/src/agentesIA/README.md (esse é
# documentação de código, não anotação pessoal) continuam indo pro repositório.
