# Porta do servidor Express
PORT=3333

# String de conexão do Postgres (Supabase) - usada pelo Prisma
# Formato Supabase: postgresql://postgres:[SUA-SENHA]@[HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:senha@localhost:5432/partify"

# Usada em migrations que exigem conexão direta (sem pgbouncer), se aplicável
DIRECT_URL="postgresql://postgres:senha@localhost:5432/partify"

# Segredo usado para assinar os tokens JWT (RF02 - Realizar Login)
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Gemini API (Agente Extrator - RF07, embeddings - RF08). Gere sua chave em
# https://aistudio.google.com/apikey — NUNCA coloque a chave de verdade neste
# arquivo (.env.example é versionado no git); a chave real só deve existir em
# backend/.env (gitignored).
GEMINI_API_KEY=""

# Nomes de modelo mudam com frequência na Gemini API - confirme os identificadores
# atuais em https://ai.google.dev/gemini-api/docs/models antes de configurar.
# GEMINI_MODEL precisa suportar responseSchema (JSON estruturado); é usado tanto
# pelo Agente Extrator (RF07, multimodal/PDF) quanto pelo Agente de Consulta
# (RF12, geração de texto a partir de contexto recuperado). GEMINI_EMBEDDING_MODEL
# precisa suportar outputDimensionality: 768.
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Supabase Storage (RF06 - Upload de Vistas Explodidas). Se SUPABASE_URL não for
# definida, o backend usa LocalFileStorageService (modo dev: salva os PDFs em
# backend/storage/, sem precisar de um bucket configurado).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="catalogos"

# Origem permitida para CORS (URL do frontend); também usada para montar o link
# de redefinição de senha enviado por e-mail (RF03)
FRONTEND_URL="http://localhost:5173"

# SMTP usado para o envio do e-mail de redefinição de senha (RF03).
# Se SMTP_HOST não for definido, o backend usa ConsoleEmailService (modo dev:
# o link de redefinição é apenas impresso no console do servidor).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Partify <no-reply@partify.com>"
